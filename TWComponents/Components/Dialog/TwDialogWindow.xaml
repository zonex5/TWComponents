<Window x:Class="TwComponents.Components.Dialog.TwDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        MaxWidth="600"
        MaxHeight="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="Height"
        AllowsTransparency="False"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="25" CornerRadius="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="{Binding IconGlyph}"
                       Foreground="{Binding IconForeground}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="32"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="18" Text="{Binding Caption}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin=" 0 10 0 20">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14" Text="{Binding Message}" />
        </StackPanel>

        <!--Buttons-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Content}"
                                Width="75"
                                Margin="5,0,0,0"
                                IsDefault="{Binding IsDefault}"
                                IsCancel="{Binding IsCancel}"
                                Click="Button_Click"
                                Tag="{Binding Result}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>